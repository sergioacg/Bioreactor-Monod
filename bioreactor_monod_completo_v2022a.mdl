      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>Bioreactor de Monod</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>Tanque agitado, seis estados: V, X, S, C, T y A. Unidad de tiempo: la HORA. Caudales en L/h, potencias en kJ/h.</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="TabContainer" Name="Bioreactor_Monod">
        <DialogControl Type="Tab" Name="Cinetica">
          <Prompt>Cinetica</Prompt>
          <DialogControl Type="Edit" Name="Y">
            <Prompt>Y</Prompt>
            <Tooltip>Y  [gX / gS]   rendimiento biomasa / sustrato</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Ks">
            <Prompt>Ks</Prompt>
            <Tooltip>Ks  [g / L]   constante de saturacion de Monod</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="umax">
            <Prompt>umax</Prompt>
            <Tooltip>umax  [1 / h]   velocidad maxima de crecimiento</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="Oxigeno">
          <Prompt>Oxigeno y energia</Prompt>
          <DialogControl Type="Edit" Name="Yxo">
            <Prompt>Yxo</Prompt>
            <Tooltip>Yxo  [gX / gO2]   rendimiento biomasa / oxigeno</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="kLa">
            <Prompt>kLa</Prompt>
            <Tooltip>kLa  [1 / h]   coeficiente de transferencia</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Cstar">
            <Prompt>Cstar</Prompt>
            <Tooltip>C*  [mg / L]   saturacion de O2 (Henry)</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="YQ">
            <Prompt>YQ</Prompt>
            <Tooltip>YQ  [kJ / mol O2]   calor por mol respirado</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="rho">
            <Prompt>rho</Prompt>
            <Tooltip>rho  [kg / L]   densidad del caldo</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="cp">
            <Prompt>cp</Prompt>
            <Tooltip>cp  [kJ / (kg K)]   calor especifico del caldo</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="UA_amb">
            <Prompt>UA_amb</Prompt>
            <Tooltip>UA  [kJ / (h K)]   perdida al ambiente</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Tamb">
            <Prompt>Tamb</Prompt>
            <Tooltip>Tamb  [C]   temperatura ambiente</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="Acidez">
          <Prompt>pH</Prompt>
          <DialogControl Type="Edit" Name="qA">
            <Prompt>qA</Prompt>
            <Tooltip>qA  [mol / gX]   acido producido por biomasa</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="CT">
            <Prompt>CT</Prompt>
            <Tooltip>CT  [mol / L]   tampon total del medio</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="pKa">
            <Prompt>pKa</Prompt>
            <Tooltip>pKa  [-]   del tampon</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Kw">
            <Prompt>Kw</Prompt>
            <Tooltip>Kw  [-]   producto ionico del agua</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="pH_med">
            <Prompt>pH_med</Prompt>
            <Tooltip>pH del medio fresco  (define A = 0)</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Ain">
            <Prompt>Ain</Prompt>
            <Tooltip>Ain  [mol / L]   acido neto en la alimentacion</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="Iniciales">
          <Prompt>Iniciales</Prompt>
          <DialogControl Type="Edit" Name="Xini">
            <Prompt>Xini</Prompt>
            <Tooltip>X(0)  [g/L]   inoculo</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Sini">
            <Prompt>Sini</Prompt>
            <Tooltip>S(0)  [g/L]   sustrato inicial</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Vini">
            <Prompt>Vini</Prompt>
            <Tooltip>V(0)  [L]   volumen inicial</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Vmax">
            <Prompt>Vmax</Prompt>
            <Tooltip>Vmax  [L]   capacidad del vaso</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Cini">
            <Prompt>Cini</Prompt>
            <Tooltip>C(0)  [mg / L]   O2 disuelto inicial</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Tini">
            <Prompt>Tini</Prompt>
            <Tooltip>T(0)  [C]   temperatura inicial</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="Aini">
            <Prompt>Aini</Prompt>
            <Tooltip>A(0)  [mol / L]   acido neto inicial</Tooltip>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
        </DialogControl>
      </DialogControl>
